---
import Layout from './Layout.astro';

export interface Props {
	title: string;
	pageTitle: string;
	subtitle?: string;
}

const { title, pageTitle, subtitle } = Astro.props;
---

<Layout title={title}>
	<main>
		<header class="article-header">
			<h1>{pageTitle}</h1>
			{subtitle && <p class="subtitle">{subtitle}</p>}
		</header>
		<article class="prose">
			<slot />
		</article>
	</main>
</Layout>

<style>
	main {
		margin: 0 auto;
		padding: 3.5rem 1.5rem 4.5rem;
		max-width: 760px;
		width: 100%;
	}
	.article-header {
		margin-bottom: 2.2rem;
		padding-bottom: 1.6rem;
		border-bottom: 1px solid var(--line);
	}
	h1 {
		font-size: clamp(1.7rem, 4vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.025em;
		margin: 0 0 0.6rem;
		background: linear-gradient(180deg, #fff 40%, #999 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.subtitle {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		color: var(--ink-faint);
	}
</style>

<style is:global>
	.prose {
		line-height: 1.9;
		color: var(--ink-soft);
		font-size: 0.96rem;
	}
	.prose h1 {
		display: none; /* markdown 首行标题由页面头部渲染,避免重复 */
	}
	.prose h2 {
		font-size: 1.32rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--ink);
		margin: 2.6rem 0 1rem;
	}
	.prose h3 {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--ink);
		margin: 1.9rem 0 0.7rem;
	}
	.prose p {
		margin: 0 0 1rem;
	}
	.prose ul,
	.prose ol {
		padding-left: 1.4rem;
		margin: 0 0 1rem;
	}
	.prose li {
		margin-bottom: 0.45rem;
	}
	.prose li::marker {
		color: var(--ink-faint);
	}
	.prose blockquote {
		margin: 0 0 1.25rem;
		padding: 0.8rem 1.2rem;
		background: var(--panel);
		border-left: 2px solid var(--line-strong);
		border-radius: 0 10px 10px 0;
		color: var(--ink-soft);
	}
	.prose blockquote p {
		margin: 0;
	}
	.prose table {
		width: 100%;
		border-collapse: collapse;
		margin: 0 0 1.25rem;
		font-size: 0.88rem;
		background: var(--panel);
		border-radius: 10px;
		overflow: hidden;
	}
	.prose th,
	.prose td {
		border: 1px solid var(--line);
		padding: 0.6rem 0.9rem;
		text-align: left;
	}
	.prose th {
		background: rgba(255, 255, 255, 0.05);
		color: var(--ink);
		font-weight: 600;
	}
	.prose code {
		background: rgba(255, 255, 255, 0.08);
		color: var(--ink);
		border-radius: 5px;
		padding: 0.15em 0.4em;
		font-size: 0.85em;
	}
	.prose pre {
		background: var(--panel);
		border: 1px solid var(--line);
		color: var(--ink);
		border-radius: 12px;
		padding: 1.1rem 1.3rem;
		overflow-x: auto;
		font-size: 0.83rem;
		line-height: 1.75;
		margin: 0 0 1.25rem;
	}
	.prose pre code {
		background: none;
		color: inherit;
		padding: 0;
	}
	.prose strong {
		color: var(--ink);
		font-weight: 600;
	}
	.prose hr {
		border: none;
		border-top: 1px solid var(--line);
		margin: 2.2rem 0;
	}
	.prose a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--line-strong);
	}
	.prose a:hover {
		text-decoration-color: var(--ink);
	}
</style>
