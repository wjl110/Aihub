---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pipeline = [
	{ title: '队列 G1–G10', desc: '按类目划分(母婴、护理、箱包…),产出带违规码 / 规则码的 case' },
	{ title: '自动驳回模型', desc: '策略因子 + 正则 + fewshot,召回率 ~95%,高置信违规直接驳回' },
	{ title: '人审队列', desc: '~5% 漏放 + 低准确率 case 进入人工审核' },
	{ title: 'AI 助审 Agent', desc: 'product_id → 商品信息插件 → 获取规则 → 违规点引用整理' },
	{ title: 'TCS 人审平台', desc: '透传疑似违规点,供审核员参考,缩短单 case 审核时长' },
];

const metrics = [
	{ value: '~11%', label: '助审信息精确率(核心痛点)', tone: 'bad' },
	{ value: '~50%', label: '召回率 / 准确率', tone: 'mid' },
	{ value: '95%', label: '自动驳回模型召回率', tone: 'good' },
	{ value: '有偏', label: '评估数据集(存在标注误差)', tone: 'bad' },
];

const points = [
	{
		num: '01',
		title: '分层误差归因',
		desc: '修正评估集偏差(双人标注 + 仲裁,算 Kappa);把「细则定位误差」和「违规点判断误差」分开量化;认识到人审 case 是被前置模型筛过的难样本分布。',
	},
	{
		num: '02',
		title: '高质量数据集 + RAG',
		desc: '以质检 / 研判复核结论为 label;固证(evidence)字段最有价值;检索键用「类目 + 违规码 + 标题 + 主图特征」多路召回;细则 ID 版本化防 label 腐化。',
	},
	{
		num: '03',
		title: '统一治理检测模型',
		desc: '定位为多标签风险分类器,输出违规码概率 + 置信度,按置信度分层路由:高置信直接驳回、中置信带 Tag 进 Agent、低置信直接人审。',
	},
	{
		num: '04',
		title: '助审产品指标',
		desc: '低精确率透传易造成锚定效应;TCS 侧埋点做 A/B 对比;覆盖量扩大跟着精确率走——先在单个「队列 × 体裁」做到 60%+ 再横向铺开。',
	},
];
---

<Layout title="CQC 大模型运营 · AI 助审 Agent 精确率分析">
	<main>
		<section class="hero">
			<div class="hero-glow" aria-hidden="true"></div>
			<p class="eyebrow">电商内容质量治理 · 问答记录</p>
			<h1>AI 助审 Agent 的<br />精确率提升问题与分析</h1>
			<p class="lede">
				围绕字节 CQC 大模型运营的完整业务链路——自动驳回模型、AI 助审 Agent、TCS
				人审平台——分析「助审信息精确率仅 ~11%」的结构性原因,并给出误差归因、RAG
				数据集与统一治理检测模型的落地建议。
			</p>
			<div class="cta-row">
				<a class="btn primary" href={`${base}/answer/`}>阅读完整分析<span class="arrow">→</span></a>
				<a class="btn ghost" href={`${base}/question/`}>查看问题原文</a>
			</div>
		</section>

		<section class="metrics">
			{metrics.map((m) => (
				<div class:list={['metric', m.tone]}>
					<span class="metric-value">{m.value}</span>
					<span class="metric-label">{m.label}</span>
				</div>
			))}
		</section>

		<section>
			<h2 class="section-title"><span class="section-index">01</span>业务链路</h2>
			<ol class="pipeline">
				{pipeline.map((step, i) => (
					<li class="pipeline-step">
						<span class="step-index">{i + 1}</span>
						<div>
							<h3>{step.title}</h3>
							<p>{step.desc}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		<section>
			<h2 class="section-title"><span class="section-index">02</span>回答要点</h2>
			<div class="point-grid">
				{points.map((p) => (
					<article class="point-card">
						<span class="point-num">{p.num}</span>
						<h3>{p.title}</h3>
						<p>{p.desc}</p>
					</article>
				))}
			</div>
		</section>

		<section>
			<h2 class="section-title"><span class="section-index">03</span>延伸阅读</h2>
			<div class="feature-stack">
				<a class="feature-card" href={`${base}/ads-gap/`}>
					<div class="feature-body">
						<h3>助审优先 vs 替代优先:与广告部门的方向对比</h3>
						<p>
							电商 CQC 走「先透传信息给人审参考,再逐步替代」,广告部门走「先替代人工选标签,再补助审」——两条路线刚好相反、也互补。为什么会形成相反路线?两边各自的隐含要求是什么?置信度分层为何是合流点?
						</p>
					</div>
					<span class="feature-arrow">→</span>
				</a>
				<a class="feature-card" href={`${base}/review-plan/`}>
					<div class="feature-body">
						<h3>从信息透传到结果复核:TCS 界面降噪与数据集建设指南</h3>
						<p>
							TCS 界面信息过载,低精确率的助审信息反而拉长审核时长。方案评价(硬前提 + 自动化偏见风险)、四阶段落地路径、技术选型、五张表的数据字段定义、数据集标准建立流程,以及新人避坑清单。
						</p>
					</div>
					<span class="feature-arrow">→</span>
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
		max-width: 1024px;
		width: 100%;
	}
	section {
		margin-bottom: 4.5rem;
	}
	.section-title {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin: 0 0 1.5rem;
	}
	.section-index {
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--ink-faint);
	}
	.hero {
		position: relative;
		text-align: center;
		padding: 2.5rem 0 1.5rem;
	}
	.hero-glow {
		position: absolute;
		inset: -40% -20% auto;
		height: 340px;
		background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.07) 0%, transparent 65%);
		pointer-events: none;
	}
	.eyebrow {
		display: inline-block;
		font-family: var(--mono);
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
		border: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.03);
		padding: 0.4rem 0.95rem;
		border-radius: 999px;
		margin-bottom: 1.4rem;
	}
	h1 {
		font-size: clamp(2.1rem, 5.5vw, 3.4rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.03em;
		margin: 0 0 1.2rem;
		background: linear-gradient(180deg, #fff 40%, #999 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.lede {
		max-width: 40rem;
		margin: 0 auto 2rem;
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.85;
	}
	.cta-row {
		display: flex;
		gap: 0.7rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.92rem;
		padding: 0.68rem 1.4rem;
		border-radius: 999px;
		transition: opacity 0.15s ease, background 0.15s ease, border-color 0.15s ease;
	}
	.btn .arrow {
		transition: transform 0.15s ease;
	}
	.btn:hover .arrow {
		transform: translateX(3px);
	}
	.btn.primary {
		background: #fff;
		color: #0a0a0a;
	}
	.btn.primary:hover {
		opacity: 0.85;
	}
	.btn.ghost {
		color: var(--ink);
		border: 1px solid var(--line-strong);
		background: transparent;
	}
	.btn.ghost:hover {
		background: rgba(255, 255, 255, 0.06);
	}
	.metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 0.8rem;
	}
	.metric {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.3rem 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		transition: border-color 0.15s ease;
	}
	.metric:hover {
		border-color: var(--line-strong);
	}
	.metric-value {
		font-family: var(--mono);
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.metric.bad .metric-value {
		color: #f87171;
	}
	.metric.mid .metric-value {
		color: #fbbf24;
	}
	.metric.good .metric-value {
		color: #34d399;
	}
	.metric-label {
		font-size: 0.85rem;
		color: var(--ink-soft);
		line-height: 1.55;
	}
	.pipeline {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.pipeline-step {
		display: flex;
		gap: 1.15rem;
		position: relative;
		padding-bottom: 1.8rem;
	}
	.pipeline-step:last-child {
		padding-bottom: 0;
	}
	.pipeline-step::before {
		content: '';
		position: absolute;
		left: 16px;
		top: 38px;
		bottom: 2px;
		width: 1px;
		background: var(--line);
	}
	.pipeline-step:last-child::before {
		display: none;
	}
	.step-index {
		flex: none;
		width: 33px;
		height: 33px;
		border-radius: 50%;
		background: var(--panel);
		border: 1px solid var(--line-strong);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 0.82rem;
		font-weight: 600;
		display: grid;
		place-items: center;
		z-index: 1;
	}
	.pipeline-step h3 {
		margin: 0.25rem 0 0.35rem;
		font-size: 1.02rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.pipeline-step p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.75;
	}
	.point-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 0.8rem;
	}
	.point-card {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.5rem 1.6rem;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.point-card:hover {
		border-color: var(--line-strong);
		background: var(--panel-hover);
	}
	.point-num {
		font-family: var(--mono);
		font-size: 0.74rem;
		color: var(--ink-faint);
		letter-spacing: 0.1em;
	}
	.point-card h3 {
		margin: 0.55rem 0 0.65rem;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.point-card p {
		margin: 0;
		font-size: 0.88rem;
		color: var(--ink-soft);
		line-height: 1.8;
	}
	.feature-stack {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.feature-card {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		text-decoration: none;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.5rem 1.7rem;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.feature-card:hover {
		border-color: var(--line-strong);
		background: var(--panel-hover);
	}
	.feature-card:hover .feature-arrow {
		transform: translateX(4px);
	}
	.feature-body h3 {
		margin: 0 0 0.55rem;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.feature-body p {
		margin: 0;
		font-size: 0.88rem;
		color: var(--ink-soft);
		line-height: 1.8;
	}
	.feature-arrow {
		flex: none;
		font-size: 1.3rem;
		color: var(--ink-soft);
		transition: transform 0.15s ease;
	}
</style>
